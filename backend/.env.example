# Secret used to sign auth JWTs. Generate a real random value for production,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=change-me-to-a-random-value

# Free at https://aistudio.google.com/app/apikey — leave unset to run with
# local-only fallbacks (keyword symptom extraction, canned phrasing, no
# personalized advice or AI-generated tips).
GEMINI_API_KEY=

# Optional: defaults to gemini-flash-latest
GEMINI_MODEL=gemini-flash-latest

# Defaults to a local SQLite file (backend/healora.db) if unset. On most
# free hosts (Render, Railway, Heroku) the filesystem is ephemeral, so
# reminders/accounts will reset on every redeploy unless you point this at
# a real Postgres database (e.g. a free instance on Supabase or Neon).
DATABASE_URL=

# Comma-separated list of allowed frontend origins in production, e.g.
# https://healora-six.vercel.app. Defaults to "*" (any origin) for local dev.
CORS_ORIGINS=*

PORT=5000
