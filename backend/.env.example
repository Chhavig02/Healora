# Secret used to sign auth JWTs. Generate a real random value for production,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=change-me-to-a-random-value

# Free at https://aistudio.google.com/app/apikey — leave unset to run with
# local-only fallbacks (keyword symptom extraction, canned phrasing, no
# personalized advice or AI-generated tips).
GEMINI_API_KEY=

# Optional: defaults to gemini-flash-latest
GEMINI_MODEL=gemini-flash-latest

# --- LLM gateway (backend/llm/) ---------------------------------------
# Gemini is the primary provider; PRIMARY_LLM_PROVIDER only needs setting
# if that ever changes. Leave FALLBACK_LLM_PROVIDER unset to run with
# Gemini only (falls straight through to each call's own deterministic
# text when Gemini is unavailable — the same behavior this app has always
# had). Set it to add a second provider Healora automatically switches to
# when Gemini hits a quota/rate limit/timeout/error — never both at once,
# and never instead of Gemini when Gemini is working.
#
# PRIMARY_LLM_PROVIDER=gemini
#
# FALLBACK_LLM_PROVIDER is one of: groq | openai | together | openrouter |
# fireworks | openai_compatible (for any other OpenAI-compatible endpoint,
# including a self-hosted one — set FALLBACK_BASE_URL for that case).
# Groq has a genuinely free tier and is a reasonable default choice.
# FALLBACK_LLM_PROVIDER=groq
# FALLBACK_API_KEY=
# FALLBACK_MODEL=
# FALLBACK_BASE_URL=

# Defaults to a local SQLite file (backend/healora.db) if unset. On most
# free hosts (Render, Railway, Heroku) the filesystem is ephemeral, so
# reminders/accounts will reset on every redeploy unless you point this at
# a real Postgres database (e.g. a free instance on Supabase or Neon).
DATABASE_URL=

# Comma-separated list of allowed frontend origins in production, e.g.
# https://healora-six.vercel.app. Defaults to "*" (any origin) for local dev.
CORS_ORIGINS=*

PORT=5000
